# 6-camera collection configuration
# Update camera device paths after running: v4l2-ctl --list-devices
# Prefer /dev/v4l/by-path/...-video-index0 if available for stable mapping.

DATA_ROOT="$HOME/Downloads"

WIDTH=1600
HEIGHT=1200
FPS=15
FORMAT=MJPG
WARMUP_FRAMES=5

CAM_FRONT=/dev/video0
CAM_FRONT_LEFT=/dev/video2
CAM_FRONT_RIGHT=/dev/video4
CAM_BACK=/dev/video6
CAM_BACK_LEFT=/dev/video8
CAM_BACK_RIGHT=/dev/video10

# US anti-flicker: 2=60Hz, 1=50Hz, 0=disabled
POWER_LINE_FREQUENCY=2

# Optional Ouster LiDAR UDP capture.
# Set ENABLE_LIDAR=0 to record cameras only.
ENABLE_LIDAR=1
LIDAR_BIND_IP=169.254.1.100
LIDAR_SENSOR_HOST=169.254.213.23
LIDAR_UDP_PORTS="7502 7503"
LIDAR_RCVBUF=16777216
LIDAR_WRITER_QUEUE=8192
LIDAR_METADATA_ONLY=0

# Optional PC-attached GPS/IMU serial capture.
# Prefer stable paths from /dev/serial/by-id/ when available.
ENABLE_GPS=1
GPS_SERIAL_DEV=/dev/serial/by-id/usb-Septentrio_Septentrio_USB_Device_3689556-if02
GPS_BAUD=115200

ENABLE_IMU=1
IMU_SERIAL_DEV=/dev/serial/by-id/usb-Xsens_MTi-30_AHRS_03683186-if01-port0
IMU_BAUD=115200
