# 6-camera + optional Ouster LiDAR collection configuration template.
# Copy this file to config.env on a new PC, then edit device paths/IPs.

# Dataset root. Each run creates dataset_YYYYMMDD_HHMMSS under this directory.
DATA_ROOT="$HOME/Downloads"

# Camera recording settings.
WIDTH=1600
HEIGHT=1200
FPS=15
FORMAT=MJPG
WARMUP_FRAMES=5

# Camera device mapping.
# On a new PC, run:
#   ./scripts/check_cameras.sh
# Prefer /dev/v4l/by-path/...video-index0 paths when available.
CAM_FRONT=/dev/video0
CAM_FRONT_LEFT=/dev/video2
CAM_FRONT_RIGHT=/dev/video4
CAM_BACK=/dev/video6
CAM_BACK_LEFT=/dev/video8
CAM_BACK_RIGHT=/dev/video10

# US anti-flicker: 2=60Hz, 1=50Hz, 0=disabled.
POWER_LINE_FREQUENCY=2

# Optional Ouster LiDAR UDP capture.
# Set ENABLE_LIDAR=0 for camera-only recording.
ENABLE_LIDAR=1

# Current known OS-1-128 setup:
#   PC wired LiDAR NIC: 169.254.1.100/16
#   Sensor host:        169.254.213.23
#   LiDAR UDP port:     7502
#   IMU UDP port:       7503
LIDAR_BIND_IP=169.254.1.100
LIDAR_SENSOR_HOST=169.254.213.23
LIDAR_UDP_PORTS="7502 7503"

# Stable raw capture defaults.
LIDAR_RCVBUF=16777216
LIDAR_WRITER_QUEUE=8192

# 0 records raw UDP payloads for point-cloud decoding.
# 1 records timestamps/metadata only, with much lower disk usage.
LIDAR_METADATA_ONLY=0

# Optional PC-attached GPS/IMU serial capture.
# On a new PC, inspect:
#   ls -l /dev/serial/by-id/ /dev/ttyUSB* /dev/ttyACM*
# Prefer /dev/serial/by-id/... paths for stable mapping across reboots.
ENABLE_GPS=0
GPS_SERIAL_DEV=/dev/serial/by-id/usb-your-gps
GPS_BAUD=115200

ENABLE_IMU=0
IMU_SERIAL_DEV=/dev/serial/by-id/usb-your-imu
IMU_BAUD=115200
